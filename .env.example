# ASRS Knowledge Graph PoC - Environment Variables
# Copy this file to .env and fill in your values

# Neo4j Database Configuration
# AuraDB instance credentials (asrs-poc)
# generated when creating an instance in the free plan
NEO4J_URI=neo4j+s://.......neo4j.io
NEO4J_USERNAME=....
NEO4J_PASSWORD=....
NEO4J_DATABASE=....
AURA_INSTANCEID=....
AURA_INSTANCENAME=asrs-poc
# test with tests/test_neo4j_connection.py

# LLM Provider API Keys
# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# Optional: Alternative LLM providers
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ASRS Data Acquisition (if API becomes available)
# ASRS_API_KEY=your_asrs_api_key

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
